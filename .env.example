# Safe starting point for GTX 1650 4 GB; actual capacity must be measured.
TF_BACKEND=timesfm3
TF_DEVICE=cuda
TF_CHECKPOINT=google/timesfm-3.0-pytorch
# Read the model's license. Set true only for permitted use.
TF_LICENSE_ACCEPTED=false
TF_MAX_CONTEXT=512
TF_MAX_HORIZON=64
TF_MAX_BATCH_SERIES=1
TF_BATCH_WINDOW_MS=0
TF_QUEUE_CAPACITY=32
TF_REQUEST_TIMEOUT_SECONDS=15
TF_WARMUP_RUNS=2
# CUDA cleanup interval; 0 restores TimesFM's per-request full collection.
TF_GC_INTERVAL_SECONDS=30
TF_MAX_UPSTREAM_REQUESTS=4
# Optional authentication. Leave empty only for local use.
TF_API_KEY=
# Optional Hugging Face commit SHA for reproducible weights.
TF_MODEL_REVISION=
